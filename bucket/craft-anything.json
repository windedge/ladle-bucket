{
    "version": "0.5.0",
    "description": "Craft Anything: understand how any software works, and craft your own.",
    "homepage": "https://getartcraft.com/apps/craft-anything",
    "license": "MIT OR Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/craft-anything/releases/download/v0.5.0/craft-anything-0.5.0-windows-x64-portable.zip",
            "hash": "45dbe3420d6254aa39ab8e15160a09539dd241ac1d1cc20fec9e7b175654a1fc",
            "extract_dir": "craft-anything-0.5.0-windows-x64-portable"
        },
        "32bit": {
            "url": "https://github.com/storytold/craft-anything/releases/download/v0.5.0/craft-anything-0.5.0-windows-x86-portable.zip",
            "hash": "4e52ac7c634f8fe63df33bbe685e46a9d86a032fb4c5ef0d0040393a9664fc33",
            "extract_dir": "craft-anything-0.5.0-windows-x86-portable"
        },
        "arm64": {
            "url": "https://github.com/storytold/craft-anything/releases/download/v0.5.0/craft-anything-0.5.0-windows-arm64-portable.zip",
            "hash": "c281c5d76a22fe810bbfb8807a85222b10cf6454457ecc9e29b7e9a13decda3a",
            "extract_dir": "craft-anything-0.5.0-windows-arm64-portable"
        }
    },
    "bin": [
        "craft-anything.exe",
        "craft-anything-cli.exe"
    ],
    "persist": "CraftAnythingData",
    "shortcuts": [
        [
            "craft-anything.exe",
            "Craft Anything"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\CraftAnythingData\")) { New-Item -ItemType Directory -Path \"$dir\\CraftAnythingData\" | Out-Null }",
        "if (!(Test-Path \"$dir\\portable.txt\")) { Set-Content -Path \"$dir\\portable.txt\" -Value 'Craft Anything portable mode' -Encoding ascii }"
    ],
    "env_set": {
        "CRAFT_ANYTHING_CONFIG_DIR": "$persist_dir\\CraftAnythingData"
    },
    "notes": [
        "Craft Anything keeps settings, logs, the projects index and the engine store in the CraftAnythingData folder next to the app (portable mode).",
        "New projects are created in Documents/Craft Anything by default; change this in Settings if you want them elsewhere.",
        "craft-anything.exe is the desktop app and craft-anything-cli.exe is the command-line tool and MCP server."
    ],
    "checkver": {
        "github": "https://github.com/storytold/craft-anything"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/craft-anything/releases/download/v$version/craft-anything-$version-windows-x64-portable.zip",
                "extract_dir": "craft-anything-$version-windows-x64-portable"
            },
            "32bit": {
                "url": "https://github.com/storytold/craft-anything/releases/download/v$version/craft-anything-$version-windows-x86-portable.zip",
                "extract_dir": "craft-anything-$version-windows-x86-portable"
            },
            "arm64": {
                "url": "https://github.com/storytold/craft-anything/releases/download/v$version/craft-anything-$version-windows-arm64-portable.zip",
                "extract_dir": "craft-anything-$version-windows-arm64-portable"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "([a-fA-F0-9]{64})\\s+\\*?$basename"
        }
    }
}
