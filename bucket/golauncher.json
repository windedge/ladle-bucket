{
    "version": "0.6.0",
    "description": "A Raycast-style launcher for Windows, written in Go with the MyGo native UI toolkit",
    "homepage": "https://github.com/eziq1/golauncher",
    "license": "MIT",
    "notes": [
        "golauncher stores its configuration and data outside the install directory: settings in %APPDATA%\\golauncher (config.json, themes, plugins, scripts) and databases/clipboard history in %LOCALAPPDATA%\\golauncher\\data, so this data is not managed by Scoop.",
        "To avoid the built-in self-installer, run 'golauncher --portable'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/eziq1/golauncher/releases/download/v0.6.0/golauncher_0.6.0_windows_amd64.zip",
            "hash": "feac09b737acd1bc8f00cbc5ca0522cd60198a5f6b22dfc8baeaecea5c6fae9e"
        },
        "arm64": {
            "url": "https://github.com/eziq1/golauncher/releases/download/v0.6.0/golauncher_0.6.0_windows_arm64.zip",
            "hash": "067bacc6e1d3836209716785613ee4658f04ba8ba1f2b29ec92a91d83de7c94f"
        }
    },
    "bin": [
        "golauncher.exe",
        "glctl.exe"
    ],
    "shortcuts": [
        [
            "golauncher.exe",
            "golauncher"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\config.json\")) { New-Item -ItemType File -Path \"$dir\\config.json\" -Force | Out-Null }"
    ],
    "checkver": {
        "github": "https://github.com/eziq1/golauncher"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/eziq1/golauncher/releases/download/v$version/golauncher_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/eziq1/golauncher/releases/download/v$version/golauncher_$version_windows_arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt",
            "regex": "$basename.*?([a-f0-9]{64})"
        }
    }
}
