{
    "version": "0.3.1",
    "description": "All your AI agent sessions in one place — browse, search, resume. Rust + GPUI.",
    "homepage": "https://github.com/iAmCorey/Wake",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/iAmCorey/Wake/releases/download/v0.3.1/wake-0.3.1-windows-x86_64.zip",
            "hash": "f470ef5621df50ddb6f50ad8593f08e8c1f6d846d3a25f2cb3f592baf3d20a25"
        }
    },
    "extract_dir": "wake-0.3.1-windows-x86_64",
    "bin": "Wake.exe",
    "persist": [
        "data"
    ],
    "shortcuts": [
        [
            "Wake.exe",
            "Wake"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\data\")) { New-Item -ItemType Directory -Path \"$dir\\data\" | Out-Null }"
    ],
    "env_set": {
        "WAKE_HOME": "$persist_dir\\data"
    },
    "notes": [
        "Windows support is experimental (since v0.2.7).",
        "Wake.exe is unsigned; SmartScreen may block first launch (click More info -> Run anyway).",
        "Wake reads agent sessions from external ~/.claude-style directories read-only. WAKE_HOME redirects where Wake looks for agent data (portable installs/testing).",
        "Setting WAKE_HOME to $dir\\data keeps all Wake data inside the portable install; by default Wake's own index lives at %LOCALAPPDATA%\\wake."
    ],
    "checkver": {
        "github": "https://github.com/iAmCorey/Wake"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iAmCorey/Wake/releases/download/v$version/wake-$version-windows-x86_64.zip",
                "extract_dir": "wake-$version-windows-x86_64"
            }
        }
    }
}
